+/* Camera persona: advertise a conventional UVC webcam profile instead of
+ * the loopback defaults, so capture clients (and their device lists) see an
+ * ordinary integrated camera. The mode table is what a typical integrated
+ * 720p-class sensor reports: 4:3 VGA/SVGA, then 16:9 HD, with full frame
+ * rates up to 720p and USB2-bandwidth rates at 1080p.
+ */
+#define CAMERA_DRIVER_NAME "uvcvideo"
+
+struct camera_mode {
+	__u32 width;
+	__u32 height;
+};
+static const struct camera_mode camera_modes[] = {
+	{ 640, 480 },
+	{ 800, 600 },
+	{ 1280, 720 },
+	{ 1920, 1080 },
+};
+#define CAMERA_MODE_COUNT ARRAY_SIZE(camera_modes)
+static const __u32 camera_fps_std[] = { 30, 25, 20, 15, 10, 5 };
+#define CAMERA_FPS_STD_COUNT ARRAY_SIZE(camera_fps_std)
+static const __u32 camera_fps_hd[] = { 15, 10, 5 };
+#define CAMERA_FPS_HD_COUNT ARRAY_SIZE(camera_fps_hd)
+
+static bool camera_mode_allowed(const struct v4l2_loopback_device *dev,
+				unsigned int i)
+{
+	return camera_modes[i].width >= dev->min_width &&
+	       camera_modes[i].width <= dev->max_width &&
+	       camera_modes[i].height >= dev->min_height &&
+	       camera_modes[i].height <= dev->max_height;
+}
+
+/* index into camera_modes of the nth allowed mode, or -1 */
+static int camera_mode_nth(const struct v4l2_loopback_device *dev,
+			   unsigned int n)
+{
+	unsigned int i;
+
+	for (i = 0; i < CAMERA_MODE_COUNT; i++) {
+		if (!camera_mode_allowed(dev, i))
+			continue;
+		if (!n)
+			return (int)i;
+		n--;
+	}
+	return -1;
+}
+
+static int camera_mode_index(const struct v4l2_loopback_device *dev,
+			     __u32 width, __u32 height)
+{
+	unsigned int i;
+
+	for (i = 0; i < CAMERA_MODE_COUNT; i++) {
+		if (camera_mode_allowed(dev, i) &&
+		    camera_modes[i].width == width &&
+		    camera_modes[i].height == height)
+			return (int)i;
+	}
+	return -1;
+}
+
+/* snap a requested size to the closest advertised mode, the way a UVC driver
+ * rounds an arbitrary request to a sensor mode: nearest aspect ratio, then
+ * nearest width. */
+static void camera_snap_size(__u32 *width, __u32 *height)
+{
+	unsigned int i, best = 0;
+	long bestscore = LONG_MAX;
+
+	for (i = 0; i < CAMERA_MODE_COUNT; i++) {
+		long ar_diff = (long)camera_modes[i].width * (long)(*height) -
+			       (long)(*width) * (long)camera_modes[i].height;
+		long size_diff = (long)camera_modes[i].width - (long)(*width);
+		long score;
+
+		if (ar_diff < 0)
+			ar_diff = -ar_diff;
+		if (size_diff < 0)
+			size_diff = -size_diff;
+		score = ar_diff * 64 + size_diff;
+
+		if (score < bestscore) {
+			bestscore = score;
+			best = i;
+		}
+	}
+	*width = camera_modes[best].width;
+	*height = camera_modes[best].height;
+}
