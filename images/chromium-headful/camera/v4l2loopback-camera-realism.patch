+/* register the fake USB device (idVendor/idProduct) and interface
+ * (interface string) levels for one loopback device */
+static int v4l2l_camera_sysfs_init(struct v4l2_loopback_device *dev, int nr)
+{
+	struct platform_device *usb, *iface;
+	int err;
+
+	usb = platform_device_alloc("v4l2loopback-usb", nr);
+	if (!usb)
+		return -ENOMEM;
+	err = platform_device_add(usb);
+	if (err) {
+		platform_device_put(usb);
+		return err;
+	}
+	if (device_create_file(&usb->dev, &dev_attr_idVendor) ||
+	    device_create_file(&usb->dev, &dev_attr_idProduct)) {
+		platform_device_unregister(usb);
+		return -ENOMEM;
+	}
+
+	iface = platform_device_alloc("v4l2loopback-usbif", nr);
+	if (!iface) {
+		platform_device_unregister(usb);
+		return -ENOMEM;
+	}
+	iface->dev.parent = &usb->dev;
+	err = platform_device_add(iface);
+	if (err) {
+		platform_device_put(iface);
+		platform_device_unregister(usb);
+		return err;
+	}
+	if (device_create_file(&iface->dev, &dev_attr_interface)) {
+		platform_device_unregister(iface);
+		platform_device_unregister(usb);
+		return -ENOMEM;
+	}
+
+	dev->usb_pdev = usb;
+	dev->iface_pdev = iface;
+	return 0;
+}
+
+static void v4l2l_camera_sysfs_free(struct v4l2_loopback_device *dev)
+{
+	if (dev->iface_pdev)
+		platform_device_unregister(dev->iface_pdev);
+	if (dev->usb_pdev)
+		platform_device_unregister(dev->usb_pdev);
+	dev->iface_pdev = NULL;
+	dev->usb_pdev = NULL;
+}
